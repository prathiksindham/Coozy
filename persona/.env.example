# Copy this file to persona/.env and fill in ONE provider.
# persona/.env is gitignored — your key stays local, never in chat or git.

# --- Free: Google Gemini (key starts with AIza..., from aistudio.google.com) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=AIza-your-real-key-here

# --- Free: local Ollama (no key) ---
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1

# --- Paid: Anthropic (best quality) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
